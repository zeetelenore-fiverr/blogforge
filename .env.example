# ---- required ----------------------------------------------------------
# 32+ random characters. Encrypts every API key stored in the database and
# signs admin sessions. Changing it makes existing stored keys unreadable.
APP_SECRET="change-me-to-a-long-random-string"

# Public origin of the blog. Used for canonical URLs, sitemap, RSS, schema.
SITE_URL="http://localhost:3000"

# ---- database ----------------------------------------------------------
# Leave unset for a local Postgres-in-process database under ./data/pg —
# no server to install, real Postgres semantics.
#
# For Supabase, copy the *pooled* connection string (Session pooler, port
# 6543). Serverless needs the pooler; the direct 5432 connection will run
# out of connections.
# DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Optional: connections per serverless instance. Leave at 1 unless you know
# you need more.
# DATABASE_MAX_CONNECTIONS="1"

# ---- optional ----------------------------------------------------------
# Shared secret for the scheduler endpoint /api/cron/tick
CRON_SECRET="change-me-too"

# Set to 1 to run the scheduler inside the Next.js process (good for a VPS or
# local dev). Leave unset on serverless and use Vercel Cron / cron-job.org.
INLINE_SCHEDULER="1"
